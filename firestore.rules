rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
          || request.auth.token.email == 'jackyyouyou0704@gmail.com'
        );
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isEventStart(value) {
      return value is string
        && value.size() <= 32
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?)?$');
    }

    function completedTaskOn(taskId, date) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/tasks/$(taskId)).data.completed == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/tasks/$(taskId)).data.completedDate == date;
    }

    function taskShape() {
      return request.resource.data.keys().hasOnly([
        'title', 'subjectId', 'dueDate', 'dueTime', 'completed', 'completedAt',
        'completedDate', 'notes', 'kind', 'createdAt', 'updatedAt', 'rolledFrom',
        'rolloverCount', 'source'
      ])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 180
        && request.resource.data.subjectId is string && request.resource.data.subjectId.size() <= 64
        && isDate(request.resource.data.dueDate)
        && request.resource.data.dueTime is string && request.resource.data.dueTime.size() <= 5
        && request.resource.data.completed is bool
        && (request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp)
        && request.resource.data.completedDate is string && (request.resource.data.completedDate == '' || isDate(request.resource.data.completedDate))
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.kind in ['study', 'revision', 'assignment', 'other']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.rolledFrom is string && request.resource.data.rolledFrom.size() <= 10
        && request.resource.data.rolloverCount is int && request.resource.data.rolloverCount >= 0 && request.resource.data.rolloverCount <= 1000
        && request.resource.data.source in ['local', 'ics', 'caldav', 'google'];
    }

    function eventShape() {
      return request.resource.data.keys().hasOnly([
        'uid', 'title', 'start', 'end', 'allDay', 'type', 'subjectId', 'paper',
        'description', 'location', 'rrule', 'source', 'externalId', 'etag',
        'updatedAt', 'deleted'
      ])
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 180
        && isEventStart(request.resource.data.start)
        && request.resource.data.end is string && request.resource.data.end.size() <= 32
        && request.resource.data.allDay is bool
        && request.resource.data.type in ['dse', 'mock', 'school', 'sba', 'study', 'custom']
        && request.resource.data.subjectId is string && request.resource.data.subjectId.size() <= 64
        && request.resource.data.paper is string && request.resource.data.paper.size() <= 40
        && request.resource.data.description is string && request.resource.data.description.size() <= 4000
        && request.resource.data.location is string && request.resource.data.location.size() <= 200
        && request.resource.data.rrule is string && request.resource.data.rrule.size() <= 1000
        && request.resource.data.source in ['local', 'ics', 'caldav', 'google']
        && request.resource.data.externalId is string && request.resource.data.externalId.size() <= 500
        && request.resource.data.etag is string && request.resource.data.etag.size() <= 500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.deleted is bool;
    }

    function checkinShape(date) {
      return request.resource.data.keys().hasOnly([
        'date', 'completedTaskCount', 'taskId', 'createdAt', 'source'
      ])
        && request.resource.data.date == date
        && isDate(request.resource.data.date)
        && request.resource.data.completedTaskCount is int && request.resource.data.completedTaskCount >= 1 && request.resource.data.completedTaskCount <= 100
        && request.resource.data.taskId is string && request.resource.data.taskId.size() > 0 && request.resource.data.taskId.size() <= 200
        && request.resource.data.taskId.matches('^[^/]+$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.source == 'cloud'
        && completedTaskOn(request.resource.data.taskId, date);
    }

    function statsShape() {
      return request.resource.data.keys().hasOnly([
        'currentStreak', 'longestStreak', 'totalDays', 'lastCheckinDate', 'updatedAt'
      ])
        && request.resource.data.currentStreak is int && request.resource.data.currentStreak >= 0 && request.resource.data.currentStreak <= 10000
        && request.resource.data.longestStreak is int && request.resource.data.longestStreak >= 0 && request.resource.data.longestStreak <= 10000
        && request.resource.data.totalDays is int && request.resource.data.totalDays >= 0 && request.resource.data.totalDays <= 10000
        && request.resource.data.lastCheckinDate is string && isDate(request.resource.data.lastCheckinDate)
        && request.resource.data.updatedAt == request.time;
    }

    function settingsShape() {
      return request.resource.data.keys().hasOnly([
        'dseYear', 'dseStartDate', 'dseEndDate', 'studyStartDate',
        'hiddenSystemExamIds', 'semesterMode', 'timezone', 'clockOffsetMs',
        'selectedSubjectIds', 'updatedAt'
      ])
        && request.resource.data.dseYear is int && request.resource.data.dseYear >= 2020 && request.resource.data.dseYear <= 2100
        && request.resource.data.dseStartDate is string && request.resource.data.dseStartDate.size() <= 10
        && request.resource.data.dseEndDate is string && request.resource.data.dseEndDate.size() <= 10
        && request.resource.data.studyStartDate is string && request.resource.data.studyStartDate.size() <= 10
        && request.resource.data.hiddenSystemExamIds is list && request.resource.data.hiddenSystemExamIds.size() <= 500
        && request.resource.data.semesterMode in ['auto', 's1', 's2', 'mock', 'dse', 'holiday']
        && request.resource.data.timezone == 'Asia/Hong_Kong'
        && request.resource.data.clockOffsetMs is int
        && request.resource.data.clockOffsetMs >= -300000
        && request.resource.data.clockOffsetMs <= 300000
        && request.resource.data.selectedSubjectIds is list
        && request.resource.data.selectedSubjectIds.size() <= 500
        && request.resource.data.updatedAt == request.time;
    }

    function leaderboardShape() {
      return request.resource.data.keys().hasOnly([
        'uid', 'displayName', 'currentStreak', 'totalDays', 'weeklySeconds',
        'weekKey', 'visible', 'writes', 'windowStart', 'updatedAt'
      ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40
        && request.resource.data.currentStreak is int && request.resource.data.currentStreak >= 0 && request.resource.data.currentStreak <= 10000
        && request.resource.data.totalDays is int && request.resource.data.totalDays >= 0 && request.resource.data.totalDays <= 10000
        && request.resource.data.weeklySeconds is int && request.resource.data.weeklySeconds >= 0 && request.resource.data.weeklySeconds <= 100000000
        && request.resource.data.weekKey is string && request.resource.data.weekKey.size() == 10
        && request.resource.data.visible is bool
        && request.resource.data.writes is int && request.resource.data.writes >= 1 && request.resource.data.writes <= 20
        && request.resource.data.windowStart is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function timerSessionShape() {
      return request.resource.data.keys().hasOnly([
        'date', 'subjectId', 'subjectName', 'paper', 'mode',
        'startedAt', 'endedAt', 'durationSeconds', 'plannedSeconds',
        'notes', 'completed', 'updatedAt'
      ])
        && isDate(request.resource.data.date)
        && request.resource.data.subjectId is string && request.resource.data.subjectId.size() > 0 && request.resource.data.subjectId.size() <= 100
        && request.resource.data.subjectName is string && request.resource.data.subjectName.size() > 0 && request.resource.data.subjectName.size() <= 100
        && request.resource.data.paper is string && request.resource.data.paper.size() <= 120
        && request.resource.data.mode in ['countdown', 'stopwatch']
        && request.resource.data.startedAt is string && isEventStart(request.resource.data.startedAt)
        && request.resource.data.endedAt is string && isEventStart(request.resource.data.endedAt)
        && request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 86400
        && request.resource.data.plannedSeconds is int && request.resource.data.plannedSeconds >= 0 && request.resource.data.plannedSeconds <= 86400
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.completed is bool
        && request.resource.data.updatedAt == request.time;
    }

    function activeTimerShape() {
      return request.resource.data.keys().hasOnly([
        'mode', 'subjectId', 'subjectName', 'paper', 'notes',
        'plannedSeconds', 'referenceSeconds', 'startedAt', 'runningSince',
        'accumulatedMs', 'status', 'updatedAt'
      ])
        && request.resource.data.mode in ['countdown', 'stopwatch']
        && request.resource.data.subjectId is string && request.resource.data.subjectId.size() > 0 && request.resource.data.subjectId.size() <= 100
        && request.resource.data.subjectName is string && request.resource.data.subjectName.size() > 0 && request.resource.data.subjectName.size() <= 100
        && request.resource.data.paper is string && request.resource.data.paper.size() <= 120
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 2000
        && request.resource.data.plannedSeconds is int && request.resource.data.plannedSeconds >= 0 && request.resource.data.plannedSeconds <= 86400
        && request.resource.data.referenceSeconds is int && request.resource.data.referenceSeconds >= 0 && request.resource.data.referenceSeconds <= 86400
        && request.resource.data.startedAt is timestamp
        && (request.resource.data.runningSince == null || request.resource.data.runningSince is timestamp)
        && request.resource.data.accumulatedMs is int && request.resource.data.accumulatedMs >= 0 && request.resource.data.accumulatedMs <= 86400000
        && request.resource.data.status in ['running', 'paused']
        && request.resource.data.updatedAt == request.time;
    }

    function winnerCardShape() {
      return request.resource.data.keys().hasOnly([
        'weekKey', 'uid', 'displayName', 'durationSeconds', 'quote',
        'imageData', 'imageStatus', 'settlementDate', 'archived', 'updatedAt'
      ])
        && isDate(request.resource.data.weekKey)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40
        && request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 0 && request.resource.data.durationSeconds <= 100000000
        && request.resource.data.quote is string && request.resource.data.quote.size() <= 80
        // Owners never write an approved image; only the admin review path does.
        && request.resource.data.imageData == ''
        && request.resource.data.imageStatus in ['none', 'pending', 'rejected']
        && isDate(request.resource.data.settlementDate)
        && request.resource.data.archived is bool
        && request.resource.data.updatedAt == request.time;
    }

    function winnerReviewShape() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageData', 'imageStatus', 'updatedAt'])
        && request.resource.data.imageStatus in ['approved', 'rejected']
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekKey == resource.data.weekKey
        && (request.resource.data.imageStatus == 'rejected'
          ? request.resource.data.imageData == ''
          : request.resource.data.imageData is string
            && request.resource.data.imageData.size() > 0
            && request.resource.data.imageData.size() <= 700000)
        && request.resource.data.updatedAt == request.time;
    }

    function winnerApprovedTextShape() {
      return resource.data.imageStatus == 'approved'
        && request.resource.data.imageStatus == 'approved'
        && request.resource.data.imageData == resource.data.imageData
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quote', 'displayName', 'durationSeconds', 'updatedAt'
        ])
        && request.resource.data.quote is string && request.resource.data.quote.size() <= 80
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.updatedAt == request.time;
    }

    function winnerSubmissionShape() {
      return request.resource.data.keys().hasOnly(['weekKey', 'uid', 'imageData', 'updatedAt'])
        && isDate(request.resource.data.weekKey)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.imageData is string
        && request.resource.data.imageData.size() > 0
        && request.resource.data.imageData.size() <= 700000
        && request.resource.data.updatedAt == request.time;
    }

    function calendarSyncConfigShape() {
      return request.resource.data.keys().hasOnly([
        'googleConnected', 'googleCalendarId', 'lastSyncAt', 'lastError', 'icalUrls', 'icalProxyUrl', 'updatedAt'
      ])
        && request.resource.data.googleConnected is bool
        && request.resource.data.googleCalendarId is string
        && request.resource.data.googleCalendarId.size() > 0
        && request.resource.data.googleCalendarId.size() <= 128
        && request.resource.data.lastSyncAt is string && request.resource.data.lastSyncAt.size() <= 40
        && request.resource.data.lastError is string && request.resource.data.lastError.size() <= 500
        && request.resource.data.icalUrls is list
        && request.resource.data.icalUrls.size() <= 10
        && request.resource.data.icalProxyUrl is string
        && request.resource.data.icalProxyUrl.size() <= 1000
        && request.resource.data.updatedAt == request.time;
    }

    function categoryColorsShape() {
      return request.resource.data.categoryColors is map
        && request.resource.data.categoryColors.keys().hasOnly(['dse', 'mock', 'schoolSba', 'study', 'custom'])
        && request.resource.data.categoryColors.dse is string
        && request.resource.data.categoryColors.dse.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.categoryColors.mock is string
        && request.resource.data.categoryColors.mock.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.categoryColors.schoolSba is string
        && request.resource.data.categoryColors.schoolSba.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.categoryColors.study is string
        && request.resource.data.categoryColors.study.matches('^#[0-9A-Fa-f]{6}$')
        && request.resource.data.categoryColors.custom is string
        && request.resource.data.categoryColors.custom.matches('^#[0-9A-Fa-f]{6}$');
    }

    function userPreferencesShape() {
      return request.resource.data.keys().hasOnly(['themeMode', 'theme', 'texture', 'categoryColors', 'updatedAt'])
        && request.resource.data.themeMode in ['system', 'octavarium', 'train']
        && request.resource.data.theme in ['light', 'dark']
        && request.resource.data.texture is bool
        && categoryColorsShape()
        && request.resource.data.updatedAt == request.time;
    }

    /*
     * Rate limit for the public board.
     *
     * `writes` counts metered changes (display name, streak, total days) in a
     * rolling one-hour window anchored at `windowStart`. Inside the window the
     * counter may only grow by one and never above 20. Once the window has
     * expired the only accepted write is a reset to 1 anchored at
     * request.time. A client therefore cannot reset the counter early, and a
     * script cannot rewrite public metrics thousands of times per hour.
     *
     * Changing only `visible` (opting out for privacy) is exempt and must stay
     * instant.
     */
    function leaderboardMeteredChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['displayName', 'currentStreak', 'totalDays']);
    }

    function leaderboardSameWindow() {
      return request.resource.data.windowStart == resource.data.windowStart;
    }

    function leaderboardBudgetUpdate() {
      return leaderboardMeteredChange()
        ? (request.time < resource.data.windowStart + duration.value(1, 'h')
            ? request.resource.data.writes == resource.data.writes + 1
              && request.resource.data.writes <= 20
              && leaderboardSameWindow()
            : request.resource.data.writes == 1
              && request.resource.data.windowStart == request.time)
        : request.resource.data.writes == resource.data.writes
          && leaderboardSameWindow();
    }

    /*
     * Exam data is shared reference data. Only an admin may replace a year, and
     * the stored timetable must declare Hong Kong time plus the recurso
     * reference used for manual time comparison.
     */
    function systemExamShape() {
      return request.resource.data.keys().hasOnly([
        'year', 'source', 'label', 'events', 'timezone', 'referenceUrl', 'updatedAt'
      ])
        && request.resource.data.year is int
        && request.resource.data.year >= 2020
        && request.resource.data.year <= 2100
        && request.resource.data.source == 'official'
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 200
        && request.resource.data.events is list
        && request.resource.data.events.size() > 0
        && request.resource.data.events.size() <= 500
        && request.resource.data.timezone == 'Asia/Hong_Kong'
        && request.resource.data.referenceUrl is string
        && request.resource.data.referenceUrl.size() <= 300
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'leaderboardOptIn', 'photoURL', 'email', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.leaderboardOptIn is bool
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'leaderboardOptIn', 'photoURL', 'email', 'updatedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.leaderboardOptIn is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && taskShape();
        allow update: if isSelf(uid)
          && taskShape()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSelf(uid);
      }

      match /events/{eventId} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && eventShape();
        allow update: if isSelf(uid) && eventShape();
        allow delete: if isSelf(uid);
      }

      // One document per date is the one-per-day lock. The create must
      // reference this user's own task, completed on exactly this date.
      match /checkins/{date} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid) && checkinShape(date);
        allow update, delete: if false;
      }

      match /meta/stats {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && statsShape();
        allow delete: if false;
      }

      match /meta/settings {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && settingsShape();
        allow delete: if false;
      }

      match /meta/{docId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /reflections/{date} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['date', 'text', 'updatedAt'])
          && isDate(request.resource.data.date)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(uid);
      }

      // Private study timer sessions: own uid only, full CRUD for corrections.
      match /timerSessions/{sessionId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && timerSessionShape();
        allow delete: if isSelf(uid);
      }

      // Persistent active timer: one private document per user.
      match /timerState/{docId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && activeTimerShape();
        allow delete: if isSelf(uid);
      }

      match /calendarConnections/{connectionId} {
        allow read, write: if false;
      }

      match /syncLogs/{logId} {
        allow read, write: if false;
      }
    }

    // Public streak board. Only the owner writes; hidden docs are readable by
    // the owner only. Metric writes are rate-limited (20 per rolling hour).
    match /leaderboard/{uid} {
      allow read: if signedIn() && (isSelf(uid) || resource.data.visible == true);
      allow create: if isSelf(uid)
        && leaderboardShape()
        && request.resource.data.writes == 1
        && request.resource.data.windowStart == request.time;
      allow update: if isSelf(uid)
        && leaderboardShape()
        && leaderboardBudgetUpdate();
      allow delete: if isSelf(uid);
    }

    // Weekly encouragement card. Owner writes their own card; only an admin can
    // move an image from pending to approved/rejected. Public reads are limited
    // to signed-in users, matching the leaderboard audience.
    match /leaderboardWinner/{cardId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && winnerCardShape()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        ? winnerReviewShape()
        : (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.weekKey == resource.data.weekKey
          && (winnerCardShape() || winnerApprovedTextShape()));
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Private pending/rejected image data. Only the owner and an admin can
    // read it; the public leaderboardWinner card never contains pending data.
    match /winnerCardSubmissions/{submissionId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && winnerSubmissionShape();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Module 1: synced Google/iCal events and the per-user sync config.
    match /userCalendarEvents/{eventId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && eventShape()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /calendarSyncConfig/{uid} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid) && calendarSyncConfigShape();
    }

    // Global theme preference, synced across the user's devices.
    match /userPreferences/{uid} {
      allow read: if isSelf(uid);
      allow write: if isSelf(uid) && userPreferencesShape();
    }

    // System timetable: public read, admin write only.
    match /systemExams/{year} {
      allow read: if true;
      allow write: if isAdmin() && systemExamShape();
    }

    // Admin markers are created manually in Firebase Console. No client write.
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
