# ---------------------------------------------------------------------------
# Mode B — Firebase Spark (all six values optional as a group)
# ---------------------------------------------------------------------------
# Leave ALL six empty to run Mode A (local-only). The app will not initialize
# Firebase and will not make any Firestore requests.
#
# Firebase Console → Project settings → Your apps → Web app → SDK setup.
# Firestore database location must be asia-east2 (Hong Kong). This cannot be
# changed after creation without recreating the database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# No Worker, CalDAV, Google Calendar OAuth or service-account values are used
# in Mode B. Those belong to the deferred Mode C and must never be VITE_*.
